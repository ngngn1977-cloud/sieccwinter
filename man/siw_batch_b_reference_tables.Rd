\name{siw_batch_b_reference_tables}
\alias{siw_batch_b_reference_tables}
\title{Map frozen Batch B tables to the reference-bundle layout}
\usage{
siw_batch_b_reference_tables(legacy)
}
\arguments{
\item{legacy}{See the package README and configuration file.}
}
\value{A named list of data frames.}
\description{Selects and renames columns of the frozen Firth, ordinal, transformation and nonlinear tables; values are never changed.}
