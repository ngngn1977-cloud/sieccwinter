\name{siw_overall_validation_status}
\alias{siw_overall_validation_status}
\title{Overall publication-validation status}
\usage{
siw_overall_validation_status(summary)
}
\arguments{
\item{summary}{See the package README and configuration file.}
}
\value{A character string.}
\description{FAIL if any comparison fails or any required reference is not PASS; NOT_TESTED if nothing was compared; otherwise PASS.}
