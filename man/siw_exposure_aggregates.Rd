\name{siw_exposure_aggregates}
\alias{siw_exposure_aggregates}
\title{Aggregate exposure export}
\usage{
siw_exposure_aggregates(dat, config, protocol = siw_posthoc_protocol())
}
\arguments{
\item{dat}{See the package README and configuration file.}
\item{config}{See the package README and configuration file.}
\item{protocol}{See the package README and configuration file.}
}
\value{A data frame with one row per quantity.}
\description{Participant-days in L01-L56, UTCI category counts and percentages, rainfall days, exposure date span, winter / spring mean UTCI and no-stress share, and participants at the minimum UCLA score. Aggregates only.}
