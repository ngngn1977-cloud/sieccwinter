\name{siw_utci_band}
\alias{siw_utci_band}
\title{UTCI category of daily means}
\usage{
siw_utci_band(u)
}
\arguments{
\item{u}{See the package README and configuration file.}
}
\value{A character vector.}
\description{Broede et al. 2012 bands as declared post hoc: no thermal stress 9-26 (9 inclusive), slight cold 0-9, moderate cold -13-0, strong cold or colder below -13, heat stress above 26.}
