\name{siw_deletion_refits}
\alias{siw_deletion_refits}
\title{Selected deletion refits}
\usage{
siw_deletion_refits(dat, config, selected)
}
\arguments{
\item{dat}{See the package README and configuration file.}
\item{config}{See the package README and configuration file.}
\item{selected}{See the package README and configuration file.}
}
\value{A data frame.}
\description{Each participant and each assessment date deleted in turn for the selected models; coefficients by the original route and intervals with the final cumulative estimator. Deletions are keyed by position or assessment day.}
