\name{siw_ordinal_refinement_plan}
\alias{siw_ordinal_refinement_plan}
\title{Load the ordinal refinement plan}
\usage{
siw_ordinal_refinement_plan(path = NULL)
}
\arguments{
\item{path}{See the package README and configuration file.}
}
\value{A list (plan) with a plan hash.}
