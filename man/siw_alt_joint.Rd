\name{siw_alt_joint}
\alias{siw_alt_joint}
\title{Joint test of several exposures}
\usage{
siw_alt_joint(data, outcome, family, exposures, covariates)
}
\arguments{
\item{data}{See the package README and configuration file.}
\item{outcome}{See the package README and configuration file.}
\item{family}{See the package README and configuration file.}
\item{exposures}{See the package README and configuration file.}
\item{covariates}{See the package README and configuration file.}
}
\value{A one-row data frame.}
\description{F test (gaussian) or likelihood-ratio test (binary) of the exposures against the covariate-only model on complete cases.}
