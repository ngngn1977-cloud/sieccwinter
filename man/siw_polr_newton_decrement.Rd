\name{siw_polr_newton_decrement}
\alias{siw_polr_newton_decrement}
\title{Newton decrement at a polr solution}
\usage{
siw_polr_newton_decrement(fit, d, exposure, covariates)
}
\arguments{
\item{fit}{See the package README and configuration file.}
\item{d}{See the package README and configuration file.}
\item{exposure}{See the package README and configuration file.}
\item{covariates}{See the package README and configuration file.}
}
\value{A number.}
\description{Affine-invariant distance of a polr solution from the likelihood maximum (0 at the maximum); recorded, never used to change a result.}
