\name{siw_firth_grid}
\alias{siw_firth_grid}
\title{The Firth sensitivity grid}
\usage{
siw_firth_grid(dat, config, core_results = NULL, verify = TRUE, tolerance = 1e-10)
}
\arguments{
\item{dat}{See the package README and configuration file.}
\item{config}{See the package README and configuration file.}
\item{core_results}{See the package README and configuration file.}
\item{verify}{See the package README and configuration file.}
\item{tolerance}{See the package README and configuration file.}
}
\value{A list with results and verification.}
\description{All binary-outcome cumulative specifications (8 metrics x 10 windows x 7 tiers = 560) with recorded convergence, failures and dropped terms; optional independent verification of every fit.}
