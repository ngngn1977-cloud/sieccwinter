\name{siw_batch_b_math_status}
\alias{siw_batch_b_math_status}
\title{Overall mathematical-verification status}
\usage{
siw_batch_b_math_status(m)
}
\arguments{
\item{m}{See the package README and configuration file.}
}
\value{A character string.}
\description{FAIL if any component fails, NOT_TESTED if any is not tested, PASS_WITH_DOCUMENTED_LIMITATION if a documented limitation was needed, otherwise PASS.}
